# VELVET Configuration
# Copy this file to .env and edit for your environment

# ─── Basic Settings ─────────────────────────────────────
MUSIC_DIR=C:\Music           # Path to your music library
DATA_DIR=velvet_data         # Data directory (database, covers, cache)
PORT=8765                    # Main server port

# ─── UPnP/DLNA Settings ──────────────────────────────────
UPNP_DEVICE_NAME=VELVET      # Device name shown to DLNA clients
UPNP_DEVICE_UUID=uuid:velvet-00000000-0000-0000-0000-000000000001

# ─── Performance Settings ─────────────────────────────────
MAX_UPSAMPLE_TIMEOUT=60      # Maximum FFmpeg stream timeout in minutes (5-60)
FFMPEG_CACHE_DIR=velvet_data/cache/ffmpeg    # Optional: cache for common sample rates

# ─── CORS (for web players) ──────────────────────────────
# Uncomment and set to your player domain(s):
# CORS_ALLOW_ORIGINS=http://player.example.com,http://192.168.1.100:8765
