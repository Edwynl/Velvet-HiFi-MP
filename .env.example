# VELVET local configuration
# Copy this file to .env, or run install.bat to create .env automatically.
# .env is machine-specific and should not be committed.

# Basic settings
VELVET_MUSIC_DIR=C:\Music
VELVET_DATA_DIR=velvet_data
VELVET_PORT=8765
VELVET_HOST=0.0.0.0

# UPnP/DLNA settings
VELVET_UPNP_FRIENDLY_NAME=VELVET
VELVET_UPNP_DEVICE_UUID=uuid:velvet-00000000-0000-0000-0000-000000000001

# Performance settings
VELVET_STREAM_TIMEOUT_MINUTES=60

# API keys are optional.
# AcoustID API key for fingerprinting: https://acoustid.org/api
# ACOUSTID_KEY=your_key_here
# VELVET_ACOUSTID_KEY=your_key_here

# Last.fm API key for artist bios fallback: https://www.last.fm/api/account/create
# LASTFM_API_KEY=your_key_here
# VELVET_LASTFM_API_KEY=your_key_here

# Optional CORS override, JSON array.
# VELVET_CORS_ORIGINS=["http://player.example.com","http://192.168.1.100:8765"]
